%= include 'header'

<div id="app">
    <div class="container bg-light card" id='homeContent'>
        <div class="row">
            <div class="col" id="col-players">
                <nav class="navbar navbar-expand-lg navbar-expand navbar-light bg-light">
                      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navBarPlayers" aria-controls="navBarPlayers" aria-expanded="false" aria-label="Toggle navigation">
                      <span class="navbar-toggler-icon"></span>
                      </button>
                      <div class="collapse navbar-collapse" id="navBarPlayers">
                        <div class="navbar-nav">
                          <a class="nav-item nav-link"
                            @click="activeRating='standard'"
                            :class="{'active': activeRating == 'standard'}" id="showStandardRating" href="#">Standard</a>
                          <a class="nav-item nav-link"
                            @click="activeRating='lightning'"
                            :class="{'active': activeRating == 'lightning'}" id="showLightningRating" href="#">Lightning</a>
                        </div>
                      </div>
                 </nav>
                <div id='playersContent' class='card shadow-m'>
                </div>
            </div>

            <div class="col-6" id="col-lobby">
                <% if (!$user || $user->{player_id} == -1) { %>
                    <a href="/register">Register to play rated games.</a>
                <% } %>
                <nav class="navbar navbar-expand-lg navbar-expand navbar-light bg-light">
                      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navBarGames" aria-controls="navBarGames" aria-expanded="false" aria-label="Toggle navigation">
                      <span class="navbar-toggler-icon"></span>
                      </button>
                      <div class="collapse navbar-collapse" id="navBarGames">
                        <div class="navbar-nav">
                          <a class="nav-item nav-link"
                            @click="activeTab='lobby';"
                            :class="{ 'active': activeTab == 'lobby' }"
                            id="showOpenGames" href="#">Lobby</a>
                          <a class="nav-item nav-link"
                            @click="activeTab='watch'; getActiveGamesStart();"
                            :class="{ 'active': activeTab == 'watch' }"
                            id="showActiveGames" href="#">Watch</a>
                        </div>
                      </div>
                 </nav>
                <div v-if="activeTab == 'lobby'" id='pool-matching' >
                </div>
                <div v-if="activeTab == 'lobby'" id='openGamesContent' class='card shadow-m'>
                    <div v-if="showPools" id='createGameButtons'>
                        <div class="d-grid gap-2">
                            <div class="btn-group d-flex gap-1" role="group" aria-label="Rated">
                                <a class="btn btn-primary p-2 text-light" id="enter-pool-standard" role="button" @click="enterPool('standard', '2way')">
                                    Standard
                                    <span v-if="inPool == 'standard 2way'" class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <div v-if="loggedIn == true">
                                        (unrated)
                                    </div>
                                </a>
                                <a class="btn btn-primary p-2 text-light" id="enter-pool-lightning" role="button" @click="enterPool('lightning', '2way')">
                                    Lightning
                                    <span v-if="inPool == 'lightning 2way'" class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <div v-if="loggedIn == true">
                                        (unrated)
                                    </div>
                                </a>
                                <a class="btn btn-primary p-2 text-light" id="enter-pool-4way-lightning" role="button" @click="enterPool('standard', '4way')">
                                    4way Lightning
                                    <span v-if="inPool == 'lightning 4way'" class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <div v-if="loggedIn == true">
                                        (unrated)
                                    </div>
                                </a>
                            </div> <!-- close btn-group -->
                            <a class="btn input-block-level btn-primary text-light" id="createGameBtn" role="button" @click="customGameForm()">
                                Custom Game
                            </a>
                            <a class="btn input-block-level btn-primary text-light" id="createAiGameBtn" role="button" @click="customGameFormAI()">
                                Play Against the AI
                            </a>
                        </div> <!-- close grid -->
                    </div> <!-- close createGameButtons -->

                <div id='myGameContent' class='card shadow-m'>
                <div v-html="myGameContent"></div>
                </div>
                <div id='challengeContent' class='card shadow-m'>
                    <div class="mx-auto" style="width: auto;">No open challenges</div>
                </div>
                <div id='publicGamesContent' class='card shadow-m'>
                    <div class="mx-auto" style="width: auto;">No open games</div>
                </div>
                </div> <!-- close openGamesContent -->
                <div v-if="showCreateGameForm == 'basic' && activeTab == 'lobby'" id='createGameFormDiv' class='card shadow-m'>
                    %= include 'createGameForm'
                </div>
                <div v-if="showCreateGameForm == 'ai' && activeTab == 'lobby'" id='createAiGameFormDiv' class='card shadow-m'>
                    %= include 'createAiGameForm'
                </div>
                <div v-if="activeTab == 'watch'" id='activeGamesContent' class='card shadow-m'>
                <div v-html="activeGamesContent"></div>
                </div>
            </div> <!--- close lobby div --->

            <div class="col" style="max-width: 100%;" id="col-chat">
                <nav class="navbar navbar-expand-lg navbar-expand navbar-light bg-light">
                      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarChat" aria-controls="navbarChat" aria-expanded="false" aria-label="Toggle navigation">
                      <span class="navbar-toggler-icon"></span>
                      </button>
                      <div class="collapse navbar-collapse" id="navbarChat">
                        <div class="navbar-nav active">
                          <a class="nav-item nav-link" href="#">Global Chat</a>
                        </div>
                      </div>
                 </nav>
                <div id='global-chat'>
                    <div id="global-chat-log" disabled="true" style="overflow-wrap: break-word;" class="text-break"></div>
                    <input type="text" id="global-chat-input" class="form-inline text-wrap"></input>
                    <div id = "connectionStatus" style='float:right;'></div>
                </div>
            </div>
        </div>
    </div>
</div>

  <script>
      let app = Vue.createApp({
          data: function () {
              return {
                  inPool: 'none',
                  loggedIn: 'false',
                  activeTab: 'lobby',
                  activeRating: 'standard',
                  showPools: true,
                  myGameContent: '',
                  showCreateGameForm: 'none',
                  activeGamesContent: '',
                  challengeContent: '<div class="mx-auto" style="width: auto;">No open challenges</div>',
                  publicGamesContent: '<div class="mx-auto" style="width: auto;">No open games</div>',
                  playerList: [],
              };
          },
          computed: {
          },
          methods: {
              getActiveGamesStart() {
                console.log('getActiveGames()');
                getActiveGames();
                console.log('getActiveGames() done');
              },
              customGameForm() {
                console.log('custom game');
                this.showPools = false;
                this.showCreateGameForm = 'basic';
              },
              customGameFormAI() {
                this.activeTab = 'lobby';
                this.showPools = false;
                this.showCreateGameForm = 'ai';
              },
              enterPool(speed, way) {
                console.log('enter Pool');
                this.showPools = true;
                this.showCreateGameForm = 'none';
                enterPoolBegin(speed, way);
              },
          }
      }).mount('#app');
  </script>

<script>
    chatLog = <%== $chatLog %>;
    <% if ($activeTab eq 'openGames') { %>
    getOpenGames();
    <% } %>
    <% if ($activeTab eq 'openGames') { %>
    getActiveGames();
    <% } %>
    currentGameUid = '<%= $currentGameUid %>'; 
</script>

%= include 'footer'
